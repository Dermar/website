{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "./gradlew :application:bootJar --no-daemon"
  },
  "deploy": {
    "startCommand": "java -jar application/build/libs/application-1.0.0.jar --server.port=$PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}